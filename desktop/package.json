{
  "name": "zalocrm-desktop",
  "version": "0.2.6",
  "private": true,
  "description": "ZaloCRM Windows desktop with floating customer chat",
  "author": "ZaloCRM",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "test:ui": "node tests/ui.cjs",
    "test:preview": "node tests/preview.cjs",
    "test:updater": "node tests/updater-lifecycle.cjs",
    "prepack": "node -e \"require('electron')\"",
    "predist": "node -e \"require('electron')\"",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "vn.joliefam.zalocrm",
    "productName": "ZaloCRM",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/installer-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "ZaloCRM-Setup-${version}.${ext}"
    }
  }
}

{
  "name": "zalocrm-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ZaloCRM Windows desktop with floating customer chat",
  "author": "ZaloCRM",
  "license": "AGPL-3.0-or-later",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "vn.joliefam.zalocrm",
    "productName": "ZaloCRM",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "src/icon.png", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "ZaloCRM-Setup-${version}.${ext}" }
  }
}
